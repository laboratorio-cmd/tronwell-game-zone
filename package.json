{
  "name": "tronwell-kids-game-zone",
  "private": true,
  "version": "0.1.0",
  "description": "TRONWELL KIDS GAME ZONE: retro space arcade for English practice (ages 10-16).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run src/education/validation",
    "check": "npm run typecheck && npm run test && vite build",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
